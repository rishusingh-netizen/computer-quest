# Frontend (Vite)
# Production defaults to https://computer-quest.vercel.app
# VITE_API_URL=https://computer-quest.vercel.app

# API server
CQ_API_PORT=3001
CQ_JWT_SECRET=change-me-to-a-long-random-string
CQ_ADMIN_EMAIL=admin@computerquest.local
CQ_ADMIN_PASSWORD=Admin@123

# Durable course price (production)
# A GitHub fine-scoped token with Contents: Read & Write on this repo
# lets admin price changes survive Vercel serverless cold starts by
# committing server/data/course-config.json
CQ_GITHUB_TOKEN=
CQ_GITHUB_OWNER=rishusingh-netizen
CQ_GITHUB_REPO=computer-quest
CQ_GITHUB_BRANCH=main
