# Frontend (Vite)
# Production defaults to https://computer-quest.vercel.app
# VITE_API_URL=https://computer-quest.vercel.app

# API server
CQ_API_PORT=3001
CQ_JWT_SECRET=change-me-to-a-long-random-string
CQ_ADMIN_EMAIL=admin@computerquest.local
CQ_ADMIN_PASSWORD=Admin@123

# ---------------------------------------------------------------------------
# Durable course price (REQUIRED for permanent production pricing on Vercel)
# ---------------------------------------------------------------------------
# The live course price is stored in server/data/course-config.json.
# On Vercel, serverless instances are ephemeral (/tmp is not permanent).
#
# READS: the API loads the price from the public GitHub raw URL for this file
# (no token needed). That is the cross-instance source of truth.
#
# WRITES (admin changes the price): set CQ_GITHUB_TOKEN so the API can commit
# the updated course-config.json back to this repo. Without the token, a price
# change only lasts until that serverless instance is recycled.
#
# Create a fine-scoped personal access token (classic or fine-grained) with
# Contents: Read and Write on the computer-quest repository, then add it in
# Vercel → Project → Settings → Environment Variables as CQ_GITHUB_TOKEN.
CQ_GITHUB_TOKEN=
CQ_GITHUB_OWNER=rishusingh-netizen
CQ_GITHUB_REPO=computer-quest
CQ_GITHUB_BRANCH=main
