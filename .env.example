# Frontend (Vite)
# Production API is live at https://computer-quest.vercel.app
# Leave unset in production (code defaults to that URL), or set explicitly:
# VITE_API_URL=https://computer-quest.vercel.app
#
# Local development (when running npm run server on :3001):
# VITE_API_URL=http://127.0.0.1:3001

# API server env (Vercel Project Settings → Environment Variables)
CQ_JWT_SECRET=change-me-to-a-long-random-string
CQ_ADMIN_EMAIL=admin@computerquest.local
CQ_ADMIN_PASSWORD=Admin@123
