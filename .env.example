# Frontend (Vite)
# Leave VITE_API_URL unset for same-origin API on Vercel production.
# Local vite dev defaults to http://127.0.0.1:3001 when unset.
# VITE_API_URL=http://127.0.0.1:3001
# VITE_API_URL=https://your-external-api.example.com

# API server (local: npm run server)
CQ_API_PORT=3001
CQ_JWT_SECRET=change-me-to-a-long-random-string
CQ_ADMIN_EMAIL=admin@computerquest.local
CQ_ADMIN_PASSWORD=Admin@123
# Optional custom DB path (default: server/data locally, /tmp on Vercel)
# CQ_DB_PATH=./server/data/computer-quest.json
